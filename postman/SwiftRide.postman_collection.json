                  "  throw new Error(\"Unexpected HTTP \" + pm.response.code);",
                  "}",
                  "const rideResponse = pm.response.json();",
                  "pm.test(\"Trip and payment belong to the same completed ride\", () => {",
                  "  pm.expect(rideResponse.trip.status).to.equal(\"Paid\");",
                  "  pm.expect(rideResponse.payment.tripId).to.equal(rideResponse.trip.id);",
                  "  pm.expect(rideResponse.payment.amount).to.equal(rideResponse.trip.quote.amount);",
                  "  pm.expect(rideResponse.paymentUnavailable).to.equal(false);",
                  "});"
                ]
              }
            }
