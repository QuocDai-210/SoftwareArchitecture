                  "}",
                  "const rideResponse = pm.response.json();",
                  "pm.test(\"Captured once for the confirmed fare\", () => {",
                  "  pm.expect(rideResponse.status).to.equal(\"Settled\");",
                  "  pm.expect(rideResponse.amount).to.equal(Number(pm.collectionVariables.get(\"fare\")));",
                  "  pm.expect(rideResponse.currency).to.equal(\"VND\");",
                  "});"
