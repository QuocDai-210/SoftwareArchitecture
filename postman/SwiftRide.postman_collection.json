{
  "info": {
    "name": "SwiftRide PDF",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      { "key": "grant_type", "value": "authorization_code_with_pkce", "type": "string" },
      { "key": "clientId", "value": "swiftride-postman", "type": "string" },
      { "key": "authUrl", "value": "{{issuer}}/protocol/openid-connect/auth", "type": "string" },
      {
        "key": "accessTokenUrl",
        "value": "{{issuer}}/protocol/openid-connect/token",
        "type": "string"
      },
      { "key": "redirect_uri", "value": "https://oauth.pstmn.io/v1/callback", "type": "string" },
      { "key": "challengeAlgorithm", "value": "S256", "type": "string" },
      { "key": "scope", "value": "openid", "type": "string" },
      { "key": "client_authentication", "value": "body", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Card",
      "item": [
        {
          "name": "Card · Opening balance",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/wallets/me",
            "header": [{ "key": "CorrelationId", "value": "{{correlationId}}" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"correlationId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) {",
                  "  pm.execution.setNextRequest(null);",
                  "  throw new Error(\"Unexpected HTTP \" + pm.response.code);",
                  "}",
                  "const rideResponse = pm.response.json();",
                  "pm.collectionVariables.set(\"opening\", rideResponse.available);"
                ]
              }
            }
          ]
        },
        {
          "name": "Card · Book",
          "request": {
            "method": "POST",
            "url": "{{gateway}}/trips",
            "header": [
              { "key": "CorrelationId", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "{{correlationId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\n    \"latitude\": 10.7769,\n    \"longitude\": 106.7009,\n    \"label\": \"Pickup\"\n  },\n  \"destination\": {\n    \"latitude\": 10.787,\n    \"longitude\": 106.713,\n    \"label\": \"Destination\"\n  },\n  \"method\": \"Card\",\n  \"paymentToken\": \"card-ok\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code !== 201) {",
                  "  pm.execution.setNextRequest(null);",
                  "  throw new Error(\"Unexpected HTTP \" + pm.response.code);",
                  "}",
                  "const rideResponse = pm.response.json();",
                  "pm.test(\"Requested\", () => pm.expect(rideResponse.status).to.equal(\"Requested\"));",
                  "pm.collectionVariables.set(\"tripId\", rideResponse.id);",
                  "pm.collectionVariables.set(\"polls\", 0);"
                ]
              }
            }
          ]
        },
        {
          "name": "Card · Wait for AwaitingRiderConfirmation",
          "request": {
            "method": "GET",
            "url": "{{gateway}}/trips/{{tripId}}",
            "header": [{ "key": "CorrelationId", "value": "{{correlationId}}" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{riderToken}}", "type": "string" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code !== 200) {",
                  "  pm.execution.setNextRequest(null);",
                  "  throw new Error(\"Unexpected HTTP \" + pm.response.code);",
                  "}",
                  "const rideResponse = pm.response.json();",
                  "const polls = Number(pm.collectionVariables.get(\"polls\"));",
                  "if (rideResponse.status !== \"AwaitingRiderConfirmation\" && polls < 60 && ![\"Failed\", \"Cancelled\", \"PaymentReview\"].includes(rideResponse.status)) {",
                  "  pm.collectionVariables.set(\"polls\", polls + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestId);",
                  "  setTimeout(() => {}, 700);",
                  "} else {",
                  "  pm.test(\"AwaitingRiderConfirmation\", () => pm.expect(rideResponse.status).to.equal(\"AwaitingRiderConfirmation\"));",
                  "  pm.collectionVariables.set(\"polls\", 0);",
                  "  if (rideResponse.status !== \"AwaitingRiderConfirmation\") pm.execution.setNextRequest(null);",
                  "}",
                  "pm.collectionVariables.set(\"version\", rideResponse.version);",
                  "if (rideResponse.quote) {",
                  "  pm.collectionVariables.set(\"quoteId\", rideResponse.quote.id);",
                  "  pm.collectionVariables.set(\"fare\", rideResponse.quote.amount);",
                  "}"
                ]
              }
            }
          ]
        },
