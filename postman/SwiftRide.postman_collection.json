                  "  pm.execution.setNextRequest(null);",
                  "  throw new Error(\"Unexpected HTTP \" + pm.response.code);",
                  "}",
                  "const rideResponse = pm.response.json();",
                  "pm.test(\"One balanced charge\", () => {",
                  "  pm.expect(rideResponse.length).to.equal(1);",
                  "  pm.expect(rideResponse[0].kind).to.equal(\"Charge\");",
                  "  const lines = rideResponse[0].lines;",
                  "  pm.expect(lines.length).to.equal(2);",
                  "  pm.expect(lines.reduce((sum, l) => sum + (l.side === \"Debit\" ? l.amount : -l.amount), 0)).to.equal(0);",
                  "});"
                ]
              }
            }
          ]
        },
