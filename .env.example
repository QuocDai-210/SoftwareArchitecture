# Run python3 scripts/setup.py to generate .env. Local demo only.
POSTGRES_ADMIN_PASSWORD=
TRIP_DB_PASSWORD=
MONGO_ROOT_PASSWORD=
MATCH_DB_PASSWORD=
PAY_DB_PASSWORD=
RABBIT_USER=swiftride
RABBIT_PASSWORD=
AUTH_SECRET=
AUTH_SIGNING_KEY=
# Optional HTTPS OIDC issuer for Rider/Driver access tokens. Empty uses demo login.
AUTH_AUTHORITY=
RIDER_PASSWORD=
DRIVER_PASSWORD=
GRAFANA_PASSWORD=
GEOAPIFY_API_KEY=
NEXT_PUBLIC_GEOAPIFY_MAP_KEY=
# External Geoapify keys above must be supplied manually; setup.py never generates them.
MAPS_PROVIDER=Geoapify
FIXTURES_ENABLED=true
# Keep false for manual Postman accept/reject scenarios; true lets the worker accept offers.
SIMULATION_AUTO_ACCEPT_DRIVERS=false
WALLET_WITHDRAWAL_OUTCOME=Completed
# COD fixture: Pending (normal), Declined, or Timeout. Restore Pending before retrying payment.
PAYMENT_SIMULATION_OUTCOME=Pending
OTEL_SDK_DISABLED=true
