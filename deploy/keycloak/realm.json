{
  "realm": "swiftride",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "roles": { "realm": [{ "name": "rider" }, { "name": "driver" }, { "name": "service" }] },
  "users": [
    {
      "username": "service-account-swiftride-service",
      "enabled": true,
      "serviceAccountClientId": "swiftride-service",
      "realmRoles": ["service"]
    },
    {
      "id": "11111111-1111-1111-1111-000000000001",
      "username": "rider1",
      "enabled": true,
      "firstName": "rider",
      "lastName": "1",
      "email": "rider1@swiftride.test",
      "emailVerified": true,
      "realmRoles": ["rider"],
      "credentials": [{ "type": "password", "temporary": false, "value": "${RIDER_PASSWORD}" }]
    },
    {
      "id": "11111111-1111-1111-1111-000000000002",
      "username": "rider2",
      "enabled": true,
      "firstName": "rider",
      "lastName": "2",
      "email": "rider2@swiftride.test",
      "emailVerified": true,
      "realmRoles": ["rider"],
      "credentials": [{ "type": "password", "temporary": false, "value": "${RIDER_PASSWORD}" }]
    },
    {
      "id": "22222222-2222-2222-2222-000000000001",
      "username": "driver1",
      "enabled": true,
      "firstName": "driver",
      "lastName": "1",
      "email": "driver1@swiftride.test",
      "emailVerified": true,
      "realmRoles": ["driver"],
      "credentials": [{ "type": "password", "temporary": false, "value": "${DRIVER_PASSWORD}" }]
    },
    {
      "id": "22222222-2222-2222-2222-000000000002",
      "username": "driver2",
      "enabled": true,
      "firstName": "driver",
      "lastName": "2",
      "email": "driver2@swiftride.test",
      "emailVerified": true,
      "realmRoles": ["driver"],
      "credentials": [{ "type": "password", "temporary": false, "value": "${DRIVER_PASSWORD}" }]
    },
    {
      "id": "22222222-2222-2222-2222-000000000003",
      "username": "driver3",
      "enabled": true,
      "firstName": "driver",
      "lastName": "3",
      "email": "driver3@swiftride.test",
      "emailVerified": true,
      "realmRoles": ["driver"],
      "credentials": [{ "type": "password", "temporary": false, "value": "${DRIVER_PASSWORD}" }]
    },
    {
      "id": "22222222-2222-2222-2222-000000000004",
      "username": "driver4",
      "enabled": true,
      "firstName": "driver",
      "lastName": "4",
      "email": "driver4@swiftride.test",
      "emailVerified": true,
      "realmRoles": ["driver"],
      "credentials": [{ "type": "password", "temporary": false, "value": "${DRIVER_PASSWORD}" }]
    }
  ],
  "clients": [
    {
      "clientId": "swiftride-postman",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://oauth.pstmn.io/v1/callback",
        "https://oauth.pstmn.io/v1/browser-callback",
        "http://127.0.0.1:8976/callback"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "swiftride-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "swiftride-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "swiftride-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
