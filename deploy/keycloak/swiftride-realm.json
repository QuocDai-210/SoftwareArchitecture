{
  "realm": "swiftride",
  "enabled": true,
  "displayName": "SwiftRide · Demo",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [{ "name": "rider" }, { "name": "driver" }, { "name": "ops" }, { "name": "service" }]
  },
  "users": [
    {
      "id": "11111111-1111-1111-1111-000000000001",
      "username": "rider1",
      "enabled": true,
      "emailVerified": true,
      "email": "rider1@swiftride.local",
      "firstName": "Rider",
      "lastName": "1",
      "realmRoles": ["rider"],
      "credentials": [{ "type": "password", "value": "${RIDER_PASSWORD}", "temporary": false }]
    },
    {
      "id": "11111111-1111-1111-1111-000000000002",
      "username": "rider2",
      "enabled": true,
      "emailVerified": true,
      "email": "rider2@swiftride.local",
      "firstName": "Rider",
      "lastName": "2",
      "realmRoles": ["rider"],
      "credentials": [{ "type": "password", "value": "${RIDER_PASSWORD}", "temporary": false }]
    },
    {
      "id": "22222222-2222-2222-2222-000000000001",
      "username": "driver1",
      "enabled": true,
      "emailVerified": true,
      "email": "driver1@swiftride.local",
      "firstName": "Driver",
      "lastName": "1",
      "realmRoles": ["driver"],
      "credentials": [{ "type": "password", "value": "${DRIVER_PASSWORD}", "temporary": false }]
    },
    {
      "id": "22222222-2222-2222-2222-000000000002",
      "username": "driver2",
      "enabled": true,
      "emailVerified": true,
      "email": "driver2@swiftride.local",
      "firstName": "Driver",
      "lastName": "2",
      "realmRoles": ["driver"],
      "credentials": [{ "type": "password", "value": "${DRIVER_PASSWORD}", "temporary": false }]
    },
    {
      "id": "22222222-2222-2222-2222-000000000003",
      "username": "driver3",
      "enabled": true,
      "emailVerified": true,
      "email": "driver3@swiftride.local",
      "firstName": "Driver",
      "lastName": "3",
      "realmRoles": ["driver"],
      "credentials": [{ "type": "password", "value": "${DRIVER_PASSWORD}", "temporary": false }]
    },
    {
      "id": "22222222-2222-2222-2222-000000000004",
      "username": "driver4",
      "enabled": true,
      "emailVerified": true,
      "email": "driver4@swiftride.local",
      "firstName": "Driver",
      "lastName": "4",
      "realmRoles": ["driver"],
      "credentials": [{ "type": "password", "value": "${DRIVER_PASSWORD}", "temporary": false }]
    },
    {
      "id": "33333333-3333-3333-3333-000000000001",
      "username": "ops1",
      "enabled": true,
      "emailVerified": true,
      "email": "ops1@swiftride.local",
      "firstName": "Ops",
      "lastName": "1",
      "realmRoles": ["ops"],
      "credentials": [{ "type": "password", "value": "${OPS_PASSWORD}", "temporary": false }]
    },
    {
      "username": "service-account-swiftride-service",
      "enabled": true,
      "serviceAccountClientId": "swiftride-service",
      "realmRoles": ["service"]
    }
  ],
  "clients": [
    {
      "clientId": "swiftride-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "swiftride-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "swiftride-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "swiftride-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "swiftride-check",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "swiftride-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
