{
  "realm": "swiftride",
  "enabled": true,
  "displayName": "SwiftRide",
  "sslRequired": "none",
  "registrationAllowed": true,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "driver" },
      { "name": "ops" },
      { "name": "service" },
      { "name": "default-roles-swiftride", "composite": true, "composites": { "realm": ["user"] } }
    ]
  },
  "users": [
    {
      "id": "33333333-3333-3333-3333-000000000001",
      "username": "ops1",
      "enabled": true,
      "emailVerified": true,
      "email": "ops1@swiftride.local",
      "firstName": "Ops",
      "lastName": "1",
      "realmRoles": ["ops"],
      "credentials": [{ "type": "password", "value": "${OPS_PASSWORD}", "temporary": false }]
    },
    {
      "username": "service-account-swiftride-service",
      "enabled": true,
      "serviceAccountClientId": "swiftride-service",
      "realmRoles": ["service"]
    },
    {
      "username": "service-account-swiftride-ops",
      "enabled": true,
      "serviceAccountClientId": "swiftride-ops",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "view-realm"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "swiftride-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "swiftride-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "swiftride-service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${SERVICE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "swiftride-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "swiftride-check",
      "enabled": false,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "swiftride-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "swiftride-ops",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OPS_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1)",
  "defaultRole": { "name": "default-roles-swiftride" }
}
