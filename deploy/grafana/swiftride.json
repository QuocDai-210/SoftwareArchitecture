{
  "title": "SwiftRide · Vận hành",
  "uid": "swiftride",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Tỷ lệ thành công trong các chuyến đã kết thúc (5 phút)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "swiftride-prometheus" },
      "targets": [
        {
          "expr": "(sum(increase(swiftride_trips_outcomes_total{status=\"paid\"}[5m])) or vector(0)) / (sum(increase(swiftride_trips_outcomes_total[5m])) > 0)",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "Matching p95",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "swiftride-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(swiftride_matching_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "API p95",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "swiftride-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Tỷ lệ lần thanh toán lỗi (5 phút)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "swiftride-prometheus" },
      "targets": [
        {
          "expr": "(sum(increase(swiftride_payment_attempts_total{status!=\"settled\"}[5m])) or vector(0)) / (sum(increase(swiftride_payment_attempts_total[5m])) > 0)",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "id": 5,
      "title": "Message chờ trong broker",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "swiftride-prometheus" },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_ready)",
          "refId": "A",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Message còn lưu trong Outbox",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "swiftride-prometheus" },
      "targets": [
        { "expr": "swiftride_outbox_messages", "refId": "A", "legendFormat": "{{service_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 7,
      "title": "Log liên kết với CorrelationId / trace_id",
      "type": "logs",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "swiftride-loki" },
      "targets": [{ "expr": "{service_name=~\"trip|payment|matching|gateway\"}", "refId": "A" }]
    }
  ]
}
